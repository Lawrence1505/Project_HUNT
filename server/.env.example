# --- Core ---
PORT=4000
# Set to "production" for any real deployment. Leave "development" for local work.
NODE_ENV=development
DATABASE_URL=postgresql://heal:healpass@localhost:5433/heal
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Extra secret mixed into OTP hashes: sha256(otp + pepper + identifier). Generate like JWT_SECRET.
OTP_PEPPER=
# Behind a reverse proxy (nginx/Caddy/Cloudflare), set this (e.g. "1" or "loopback")
# so rate limiting keys on the real client IP. Leave empty for direct binding.
TRUST_PROXY=

# --- Email OTP (Gmail SMTP is free — use a Google App Password, never your real password) ---
# Leave SMTP_USER empty to use the console fallback (OTPs are printed to the server log).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HEAL <you@gmail.com>"

# --- Dev conveniences ---
# SECURITY: when true, /otp/request returns the OTP in the HTTP response body.
# This is a local-dev-only convenience and REQUIRES NODE_ENV=development to take
# effect (fail-closed). NEVER set true in production — it enables account takeover.
DEV_ECHO_OTP=false

# --- Phone OTP ---
# dev      -> server-generated OTP printed to the server console (free, default)
# firebase -> client uses Firebase Phone Auth; backend verifies the Firebase ID token
SMS_PROVIDER=dev
# Required only when SMS_PROVIDER=firebase (Google bills per SMS on the Blaze plan)
FIREBASE_PROJECT_ID=
