# HEAL frontend env (Vite). Copy to .env and fill in — never commit real values.
# All VITE_* values are embedded in the client bundle; only put public config here.

# Phone OTP provider: dev (server-console OTP, free) | firebase (Firebase Phone Auth)
VITE_SMS_PROVIDER=dev

# Firebase web-app config — required only when VITE_SMS_PROVIDER=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
